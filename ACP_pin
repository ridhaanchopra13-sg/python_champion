class Account:
    def __init__(self, owner, pin):
        self.owner = owner
        self.__pin = pin   
    def show_pin_status(self):
        print("Account Owner:", self.owner)
        print("PIN is safely stored inside")
    def pin(self, new_pin):
        if len(new_pin) == 4 and new_pin.isdigit():
            self.__pin = new_pin
            print("PIN updated successfully.")
        else:
            print("Invalid PIN. PIN must be exactly 4 digits.")
    def check_pin(self, entered_pin):
        if entered_pin == self.__pin:
            print("Access granted.")
        else:
            print("Access denied.")
    def __str__(self):
        return "Account holder: " + self.owner
my = Account("Ridhaan", "1234")
print(my)
my.show_pin_status()
my.__pin = "9999"
print("Tried changing PIN directly from outside.")
my.check_pin("9999")
my.check_pin("1234")
my.pin("9999")
my.check_pin("9999")